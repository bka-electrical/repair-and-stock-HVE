# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Serverless API (Vercel/Node)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

WHATSAPP_PHONE=6281259385874
WHATSAPP_API_KEY=<API key dari CallMeBot>

# CORS: set to your deployed Vercel URL, comma-separated list
# Example: ALLOWED_ORIGINS=https://laporan-pekerjaan.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ⚠️  Configure all of the above in your Vercel dashboard
#     under Settings → Environment Variables
#     for all environments (Preview + Production).
